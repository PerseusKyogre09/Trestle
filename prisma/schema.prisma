generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Case {
  id                String             @id
  title             String
  description       String
  originalInput     String
  status            String             @default("active")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  actions           Action[]
  approvals         Approval[]
  executionAttempts ExecutionAttempt[]
}

model Action {
  id                String             @id
  caseId            String
  title             String
  description       String
  status            String             @default("pending")
  priority          String
  riskLevel         String
  approvalRequired  Boolean            @default(false)
  requiredInputs    String
  successCriteria   String
  evidence          String
  executionMode     String
  dependencies      String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  case              Case               @relation(fields: [caseId], references: [id], onDelete: Cascade)
  approvals         Approval[]
  executionAttempts ExecutionAttempt[]

  @@index([caseId])
}

model Approval {
  id                   String             @id
  caseId               String
  actionId             String
  status               String             @default("pending")
  operationDescription String
  destination          String?
  payload              String
  payloadHash          String
  riskCategory         String
  prohibitsAutomation  Boolean            @default(false)
  createdAt            DateTime           @default(now())
  expiresAt            DateTime
  decidedAt            DateTime?
  decisionReason       String?
  decisionAudit        String?
  case                 Case               @relation(fields: [caseId], references: [id], onDelete: Cascade)
  action               Action             @relation(fields: [actionId], references: [id], onDelete: Cascade)
  executionAttempts    ExecutionAttempt[]

  @@index([caseId])
  @@index([actionId])
  @@index([payloadHash])
}

model ExecutionAttempt {
  id                String    @id
  caseId            String
  actionId          String
  approvalId        String?
  provider          String
  status            String
  startedAt         DateTime  @default(now())
  finishedAt        DateTime?
  isSimulated       Boolean   @default(true)
  resultSummary     String?
  resultDetails     String?
  evidence          String?
  uncertaintyReason String?
  case              Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  action            Action    @relation(fields: [actionId], references: [id], onDelete: Cascade)
  approval          Approval? @relation(fields: [approvalId], references: [id], onDelete: SetNull)

  @@index([caseId])
  @@index([actionId])
}
