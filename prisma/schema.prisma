generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Case {
  id                    String                 @id
  title                 String
  description           String
  originalInput         String
  status                String                 @default("active")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  actions               Action[]
  approvals             Approval[]
  executionAttempts     ExecutionAttempt[]
  workflowRuns          WorkflowRun[]
  sharedBrowserSessions SharedBrowserSession[]
}

model Action {
  id                String             @id
  caseId            String
  sequence          Int                @default(0)
  title             String
  description       String
  status            String             @default("pending")
  priority          String
  riskLevel         String
  approvalRequired  Boolean            @default(false)
  requiredInputs    String
  successCriteria   String
  evidence          String
  executionMode     String
  dependencies      String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  case              Case               @relation(fields: [caseId], references: [id], onDelete: Cascade)
  approvals         Approval[]
  executionAttempts ExecutionAttempt[]

  @@index([caseId])
}

model Approval {
  id                   String             @id
  caseId               String
  actionId             String
  status               String             @default("pending")
  operationType        String             @default("")
  operationDescription String
  destination          String?
  payload              String
  payloadHash          String
  riskCategory         String
  prohibitsAutomation  Boolean            @default(false)
  createdAt            DateTime           @default(now())
  expiresAt            DateTime
  decidedAt            DateTime?
  decisionReason       String?
  decisionAudit        String?
  case                 Case               @relation(fields: [caseId], references: [id], onDelete: Cascade)
  action               Action             @relation(fields: [actionId], references: [id], onDelete: Cascade)
  executionAttempts    ExecutionAttempt[]

  @@index([caseId])
  @@index([actionId])
  @@index([payloadHash])
}

model ExecutionAttempt {
  id                String    @id
  caseId            String
  actionId          String
  approvalId        String?
  provider          String
  status            String
  startedAt         DateTime  @default(now())
  finishedAt        DateTime?
  isSimulated       Boolean   @default(true)
  resultSummary     String?
  resultDetails     String?
  evidence          String?
  uncertaintyReason String?
  case              Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  action            Action    @relation(fields: [actionId], references: [id], onDelete: Cascade)
  approval          Approval? @relation(fields: [approvalId], references: [id], onDelete: SetNull)

  @@index([caseId])
  @@index([actionId])
}

model WorkflowRun {
  id              String    @id
  caseId          String
  status          String    @default("running")
  mode            String    @default("autonomous")
  currentActionId String?
  pauseRequested  Boolean   @default(false)
  runnerClaimed   Boolean   @default(false)
  errorMessage    String?
  context         String    @default("{}")
  events          String    @default("[]")
  activeLock      String?   @unique
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  finishedAt      DateTime?
  case            Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
}

model SharedBrowserSession {
  id                  String   @id
  caseId              String
  providerSessionId   String   @unique
  encryptedConnection String
  status              String   @default("connecting")
  controlOwner        String   @default("agent")
  commandClaimed      Boolean  @default(false)
  currentUrl          String?
  pageTitle           String?
  lastActivity        String?
  selectedUrl         String?
  selectionSource     String?
  selectionReason     String?
  actionId            String?
  institution         String?
  allowedDomain       String?
  isTestMode          Boolean  @default(false)
  activeLock          String?  @unique
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  case                Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, updatedAt])
}
